{
  "schema_version": "duecare.ui_audit.v1",
  "review_date": "2026-05-14",
  "purpose": "Single source of truth for pre-recording UI, notebook, and interaction audit.",
  "status_legend": {
    "static_verified": "Route, title, required controls, and copy can be checked without a live model.",
    "live_required": "Needs a running Kaggle kernel and Cloudflare URL.",
    "model_required": "Needs a loaded Gemma 4 model.",
    "visual_required": "Needs desktop, tablet, and mobile screenshots.",
    "follow_up": "Known improvement opportunity, not a blocking route failure."
  },
  "global_gates": [
    "Every kernel has README, kernel.py, and kernel-metadata.json.",
    "Every static page has shared top chrome or is intentionally standalone.",
    "Every primary action button has a visible result, disabled/loading state, and activity log entry.",
    "Every file input states accepted formats, privacy boundary, and output artifact.",
    "Every model-dependent action states whether Gemma 4 is required, optional, or not used.",
    "Every result view exposes raw JSON or a downloadable artifact when practical.",
    "Every diagram or ecosystem claim has a runnable page, source artifact, or appendix notebook behind it.",
    "Every first-run path distinguishes local instance, enterprise/on-prem screening, and networked hub deployment.",
    "Every hub-sharing surface states that raw cases stay local, submissions are sanitized, and humans vet knowledge-pack changes.",
    "No visible mojibake, stale notebook names, unexplained placeholders, or redundant public-website copy.",
    "Screenshots exist for desktop, tablet, and mobile before final video recording."
  ],
