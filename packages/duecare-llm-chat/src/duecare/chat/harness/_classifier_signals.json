  "curator": "Duecare team",
  "notes": "Per-use-case rule signals for the analog prompt classifier. Each entry contributes its `weight` to the named `use_case` when the lowercased `signal` substring appears in the prompt. Multi-area prompts pick up signal from MULTIPLE use-cases. The classifier soft-normalises across use-cases — never one-hot. v2 adds the optional `lang` field (BCP 47 code: en, tl/fil, id, ne, bn, my, ar, es, vi, si, ta, ur) so non-English origin-corridor signals can be added without losing language provenance. Default lang = 'en' if not specified. Substring matching is Unicode-safe via Python's lower() — non-Latin scripts work as-is. Stakeholders who want to add signals can submit a single-file PR. Use-cases: worker_asking | ngo_intake | lawyer_research | regulator_audit | journalist_fact_check | researcher_tagging | adversarial_recruiter.",
  "supported_languages": {
    "en":    "English",
    "tl":    "Tagalog / Filipino (PH)",
    "id":    "Indonesian / Bahasa Indonesia (ID)",
    "ne":    "Nepali (NP) — Devanagari",
    "bn":    "Bengali (BD) — Bengali script",
    "my":    "Burmese (MM) — Myanmar script",
    "ar":    "Arabic (Gulf destination)",
    "es":    "Spanish (Latam corridors)",
    "vi":    "Vietnamese (VN) — Latin with diacritics",
    "si":    "Sinhala (LK)",
    "ta":    "Tamil (LK / IN)",
    "ur":    "Urdu (PK / Gulf destination)"
  },
