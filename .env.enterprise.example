# Copy to .env.enterprise before running docker-compose.enterprise.yml.
# Replace every placeholder with a strong, deployment-specific value.

DUECARE_VERSION=local
HTTP_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Leave empty for a private local demo, or set a bearer token for /api/* routes.
DUECARE_API_TOKEN=

POSTGRES_DB=duecare_db
POSTGRES_USER=duecare_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=replace-with-a-strong-grafana-password
GRAFANA_SECRET_KEY=replace-with-a-long-random-grafana-secret

DUECARE_MODEL_BACKEND=ollama
DUECARE_MODEL_NAME=gemma4:e2b
LOG_LEVEL=INFO
