{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DUECARE_DATA_DIR": ".duecare-smoke"
  },
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe scripts/validate_public_surface.py)",
      "Bash(.venv/Scripts/python.exe scripts/validate_public_surface.py --json)",
      "Bash(.venv/Scripts/python.exe scripts/validate_public_messaging.py)",
      "Bash(.venv/Scripts/python.exe scripts/validate_notebooks.py)",
      "Bash(.venv/Scripts/python.exe scripts/verify.py)",
      "Bash(.venv/Scripts/python.exe -m compileall -q apps/duecare-ai.com/app)",
      "Bash(.venv/Scripts/python.exe -m compileall apps/duecare-ai.com/app)",
      "Bash(make audit)",
      "Bash(make verify)",
      "Bash(make verify-all)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(npx tsc)",
      "Bash(npx tsc --noEmit)",
      "Bash(pre-commit run --all-files)",
      "Bash(pre-commit run public-surface-audit --hook-stage pre-push)",
      "Bash(pre-commit run public-surface-audit --hook-stage pre-push --all-files)",
      "Bash(pre-commit run canonical-messaging --hook-stage pre-push)",
      "Bash(pre-commit run canonical-messaging --hook-stage pre-push --all-files)",
      "Bash(pre-commit run notebook-validator --hook-stage pre-push --all-files)"
    ]
  }
}
