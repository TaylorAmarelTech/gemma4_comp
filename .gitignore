# Reference material (not part of the public hackathon repo)
_reference/

# Local code-intelligence index (codegraph MCP server, per-machine)
.codegraph/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.local
.env.enterprise
.env.enterprise.local

# Local key store (consolidated provider keys; never committed)
.agent/

# Codex scratch dir (generated review-packet artifacts; keep generated reports out of commits)
.codex_tmp/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Judge-facing Kaggle bundles are script kernels. Taylor copies kernel.py
# into Kaggle manually; do not track root submission notebook wrappers.
kaggle/*/notebook.ipynb
kaggle/kernels/
kaggle/kernels/**/*.ipynb

# Archived legacy notebook mirrors and skunkworks experiments now live under
# _archive/legacy-research-2026-05-09/ or outside this repo. Keep root copies
# out of the active submission workspace unless explicitly restored.
legacy_notebooks/
skunkworks/
/notebooks/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local AI-agent state. Keep .claude/rules tracked, but never commit
# transient session logs or nested app-local agent state.
.claude/sessions/
apps/**/.claude/
packages/**/.claude/

# Aider coding-harness runtime state. The configs (.aider.conf.yml,
# .aider.model.metadata.json, .aider.model.settings.yml) ARE committed; the
# launchers redirect history into .aider/, and Aider writes its repo-map cache
# to .aider.tags.cache.* — all local-only. See docs/ollama_coding_harness.md.
.aider/
.aider.tags.cache.v3/
.aider.tags.cache.v4/

# Models, weights, checkpoints (too large for git; publish via HF Hub)
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
checkpoints/
models/weights/
models/cache/

# Data files (large; publish via Kaggle Datasets)
*.parquet
*.arrow
data/raw/
data/processed/
data/interim/

# PII-bearing harvested data (Google Drive ingest cache + entity tables)
# These contain real complainant names/emails/phones from legal source
# documents; NEVER track in git per .claude/rules/10_safety_gate.md.
data/drive_text_cache/
data/drive_image_cache/
data/drive_*.json
data/drive_*.md
data/drive_*.npz
data/_drive_*
data/_curated_drive_*

# Scraped multimodal image caches (chat screenshots, ID/passport/contract
# scans). ~181 MB of binary fixtures with real-person-named files — a
# 10_safety_gate.md PII concern in a public repo, and pure bloat. No test
# imports them; regenerate via scripts/curate_multimodal_test_set.py.
data/curation_cache/
data/multimodal_test_set/

